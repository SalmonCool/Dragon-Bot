# Copy to .env and fill in. Never commit .env.

# --- Discord (required) --------------------------------------------------

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Your Discord server's ID. Enable Developer Mode in Discord
# (User Settings -> Advanced), then right-click the server -> Copy Server ID.
DISCORD_GUILD_ID=

# --- Web UI (optional) ---------------------------------------------------
# The web server only starts when WEB_PASSWORD is set. Leave blank to disable.

# Shared password. Once this is reachable from the internet it is the only
# thing between a stranger and control of the bot — make it long.
WEB_PASSWORD=

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Must be 16+ characters.
WEB_SECRET=

WEB_PORT=8080

# Interface to bind. Leave as 127.0.0.1 in production — Caddy fronts the app,
# and binding 0.0.0.0 would expose the port directly over plain HTTP, bypassing
# TLS with the password in cleartext. Use 0.0.0.0 only for LAN testing.
WEB_HOST=127.0.0.1

# Public URL of the web UI, handed out by the /panel command. Cannot be worked
# out at runtime: behind a reverse proxy the app only sees 127.0.0.1:8080 and
# has no idea what hostname reached it. Leave blank to disable /panel.
# Example: https://dragon-bot.duckdns.org
WEB_URL=

# true only when served over HTTPS (e.g. behind Caddy). On plain HTTP the
# Secure cookie flag makes the browser drop the session and login never works.
WEB_SECURE=false

# --- YouTube (optional) --------------------------------------------------

# Path to yt-dlp if it isn't on PATH.
YTDLP_PATH=

# Netscape-format cookies.txt from a browser logged into YouTube. Fixes
# "Sign in to confirm you're not a bot", which is common on VPS IPs.
# This file is account credentials: chmod 600 it, and never commit it.
YTDLP_COOKIES=

# --- Storage (optional) --------------------------------------------------

# Size cap for downloaded audio, in GB. When exceeded, the least-recently-played
# downloads are deleted until it fits. Only files the bot downloaded are counted
# or removed — sounds you added by hand are never touched, and a file that is
# currently playing is skipped. Set 0 to disable eviction entirely.
# Default is 10, which leaves room for the OS on a 25 GB droplet.
CACHE_MAX_GB=10
